{
  "expo": {
    "name": "RPG Life",
    "slug": "rpg-life",
    "version": "2.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "rpglife",
    "icon": "./android/app/src/main/res/drawable-xxxhdpi/splashscreen_logo.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./android/app/src/main/res/drawable-xxxhdpi/splashscreen_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#111827"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rpglife.mobile",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthShareUsageDescription": "This app uses HealthKit to track your daily steps for fitness goals.",
        "NSHealthUpdateUsageDescription": "This app updates HealthKit with your step data."
      }
    },
    "android": {
      "package": "com.rpglife.mobile",
      "versionCode": 3,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BODY_SENSORS",
        "com.google.android.gms.permission.ACTIVITY_RECOGNITION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./android/app/src/main/res/drawable-xxxhdpi/splashscreen_logo.png",
        "backgroundColor": "#111827"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "rpglife"
            }
          ]
        }
      ]
    },
    "extra": {
      "apiBaseUrl": "https://192.168.0.174:8000",
      "eas": {
        "projectId": "161a1a7b-1136-4d34-88e1-3e0e6297c89c"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications"
    ],
    "owner": "ponka22311"
  }
}

{
  "expo": {
    "name": "RPG Life",
    "slug": "rpg-life",
    "version": "1.4",
    "newArchEnabled": false,
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "rpglife",
    "icon": "./android/app/src/main/res/drawable-xxxhdpi/splashscreen_logo.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./android/app/src/main/res/drawable-xxxhdpi/splashscreen_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#111827"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rpglife.mobile",
      "buildNumber": "7",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMotionUsageDescription": "This app reads your motion activity to sync daily step progress.",
        "NSHealthShareUsageDescription": "This app uses HealthKit to track your daily steps for fitness goals.",
        "NSHealthUpdateUsageDescription": "This app updates HealthKit with your step data."
      }
    },
    "android": {
      "package": "com.rpglife.mobile",
      "versionCode": 7,
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./android/app/src/main/res/drawable-xxxhdpi/splashscreen_logo.png",
        "backgroundColor": "#111827"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "rpglife"
            },
            {
              "scheme": "com.rpglife.mobile"
            }
          ]
        }
      ]
    },
    "extra": {
      "apiBaseUrl": "https://rpglife.online/api/v1",
      "allowCustomApiOverride": false,
      "requireHttps": true,
      "eas": {
        "projectId": "161a1a7b-1136-4d34-88e1-3e0e6297c89c"
      }
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications"
    ],
    "owner": "ponka22311"
  }
}

APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql+psycopg2://rpg_user:replace-db-password@postgres:5432/rpg_life
ALLOW_SQLITE_FALLBACK=false

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

USE_INTERNAL_SCHEDULER=false
AUTO_CREATE_TABLES=false

COOKIE_SECURE=true
COOKIE_SAMESITE=lax

CORS_ALLOWED_ORIGINS=https://beta-api.example.com,https://beta.example.com
CORS_ALLOW_ORIGIN_REGEX=

ADMIN_EMAILS=

CACHE_TTL_LEADERBOARD=60
CACHE_TTL_PROFILE=45
CACHE_TTL_INVENTORY=30
CACHE_TTL_EVENTS=60

ENABLE_PUSH_DISPATCH=true
ENABLE_ACCOUNT_RECOVERY=false
EXPO_PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send
EXPO_PUSH_ACCESS_TOKEN=
PUSH_QUEUE_BATCH_SIZE=50
PUSH_QUEUE_MAX_ATTEMPTS=5
PUSH_QUEUE_RETRY_DELAY_SECONDS=60

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_QUEST_REWRITE_ENABLED=true
OPENAI_QUEST_MODEL=gpt-5-mini
OPENAI_QUEST_TIMEOUT_SECONDS=20
QUEST_TEXT_PROVIDER=free
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=
OLLAMA_QUEST_MODEL=qwen2.5:7b-instruct
OLLAMA_QUEST_TIMEOUT_SECONDS=20

POSTGRES_DB=rpg_life
POSTGRES_USER=rpg_user
POSTGRES_PASSWORD=replace-db-password

SOCIAL_AUTH_REDIRECT_SCHEME=rpglife
PUBLIC_BASE_URL=
EXPO_PUBLIC_SOCIAL_AUTH_REDIRECT_SCHEME=rpglife

GOOGLE_AUTH_ENABLED=true
GOOGLE_AUTH_MOBILE_CLIENT_ID=723557656382-ol45mkmikajrkjs1amidtkkmf08q8ftq.apps.googleusercontent.com
GOOGLE_AUTH_ANDROID_CLIENT_ID=
GOOGLE_AUTH_IOS_CLIENT_ID=
GOOGLE_AUTH_WEB_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_MAX_AGE_SECONDS=900
EXPO_PUBLIC_GOOGLE_AUTH_CLIENT_ID=723557656382-ol45mkmikajrkjs1amidtkkmf08q8ftq.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_AUTH_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_AUTH_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_AUTH_WEB_CLIENT_ID=

YANDEX_AUTH_ENABLED=false
YANDEX_AUTH_MOBILE_CLIENT_ID=
